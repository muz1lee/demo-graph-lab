{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kw_independent.graspnet.request.v1",
  "title": "Standalone Grasp Proposal Request",
  "type": "object",
  "required": ["schema", "inputs"],
  "properties": {
    "schema": {
      "const": "kw_independent.graspnet.request.v1"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image_path": {"type": "string"},
        "depth_path": {"type": "string"},
        "point_cloud_path": {"type": "string"},
        "mask_path": {"type": "string"},
        "object_hint": {"type": "string"},
        "frame_id": {"type": "string"},
        "coordinate_frame": {"type": "string"},
        "camera_intrinsics": {"type": "object"}
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
