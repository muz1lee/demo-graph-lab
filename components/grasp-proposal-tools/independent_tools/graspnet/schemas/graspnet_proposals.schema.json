{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kw_independent.graspnet.proposals.v1",
  "title": "Standalone Grasp Proposals",
  "type": "object",
  "required": ["schema", "source_policy", "num_proposals", "proposals"],
  "properties": {
    "schema": {
      "const": "kw_independent.graspnet.proposals.v1"
    },
    "source_policy": {
      "const": "external_grasp_proposals_no_route_decision"
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "input_reference": {
      "type": "object",
      "additionalProperties": true
    },
    "raw_response_path": {
      "type": ["string", "null"]
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "num_raw_candidates": {
      "type": "integer",
      "minimum": 0
    },
    "num_proposals": {
      "type": "integer",
      "minimum": 0
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal_id", "rank", "raw_index", "pose", "evidence"],
        "properties": {
          "proposal_id": {"type": "string"},
          "rank": {"type": "integer", "minimum": 0},
          "raw_index": {"type": ["integer", "string"]},
          "score": {"type": ["number", "null"]},
          "confidence": {"type": ["number", "null"]},
          "object_id": {"type": ["string", "null"]},
          "pose": {
            "type": "object",
            "required": ["coordinate_frame"],
            "properties": {
              "translation": {
                "type": ["array", "null"],
                "items": {"type": "number"},
                "minItems": 3,
                "maxItems": 3
              },
              "rotation_matrix": {
                "type": ["array", "null"]
              },
              "quaternion": {
                "type": ["array", "null"],
                "items": {"type": "number"},
                "minItems": 4,
                "maxItems": 4
              },
              "coordinate_frame": {"type": "string"},
              "source_fields": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": true
          },
          "approach": {
            "type": ["array", "null"],
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3
          },
          "width": {"type": ["number", "null"]},
          "depth": {"type": ["number", "null"]},
          "height": {"type": ["number", "null"]},
          "contact_region": {"type": ["string", "null"]},
          "collision_free": {"type": ["boolean", "null"]},
          "reachable": {"type": ["boolean", "null"]},
          "evidence": {
            "type": "object",
            "additionalProperties": true
          },
          "raw": {}
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
