# 1022 sandbox 示例（复制为 configs/env.sh；该文件勿进公开仓）
# 切勿对 configs/env.sh / configs/local/ / knowin-world/ / venvs/ 使用 rsync --delete。

export KNOWIN_SIM_ROOT=/mnt/data/wenqian/demo-graph-lab
export KNOWIN_REPO=/mnt/data/wenqian/demo-graph-lab/knowin-world
export UV_PROJECT_ENVIRONMENT=/mnt/data/wenqian/demo-graph-lab/venvs/knowin-world
export KNOWIN_DATA_ROOT=/mnt/nas/knowin_sim/sim_workspace/knowin-world-data
export ROBOT_MODEL=k1s_v3_w_claw_sim_v0
# 使用本机拷贝的 sim_cfg（含 frame_request_timeout=5.0），不要改 NAS 基础仓
export ROBOT_CONFIG=/mnt/data/wenqian/demo-graph-lab/configs/local/k1s_v3_w_claw_sim_v0.sim_cfg.yaml
export KNOWIN_SCENE_BACKEND=cuda
export CUDA_VISIBLE_DEVICES=2
export WEBUI_HOST=0.0.0.0
export WEBUI_PORT=5150
export WEBUI_FPS=3
export WEBUI_SESSION=wq_web_zenoh
export WEBUI_LOG=$KNOWIN_SIM_ROOT/logs/wq_web_zenoh.log
export KNOWIN_ROBOT_FINGER_SOL_PARAMS_PRIORITY_OVERRIDE=1
export KNOWIN_ROBOT_FINGER_FRICTION_OVERRIDE=
export KNOWIN_SCENE_PROP_DAMPRATIO_OVERRIDE=
export KNOWIN_SCENE_YAML=$KNOWIN_DATA_ROOT/scenes/robodojo/insert_tubes/insert_tubes_000.scene.yaml
export SIM_UI_FRAME_TIMEOUT=5.0
export SIM_UI_FRAME_REQUEST_TIMEOUT=5.0
export DOF_PIPELINE_SERVER_URL=http://101.132.143.105:5093
export GRASP_PICKPLACE_DOF_PIPELINE_SERVER_URL=http://101.132.143.105:5093
