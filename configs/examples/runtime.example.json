{
  "schema": "demo_graph.runtime_config.v1",
  "timeout_s": 2.0,
  "endpoints": [
    {
      "name": "webui",
      "base_url": "http://127.0.0.1:5049",
      "health_path": "/api/pipeline_status",
      "schema": "webui_pipeline_status.v1"
    },
    {
      "name": "pipeline",
      "base_url": "http://127.0.0.1:8000",
      "health_path": "/pipeline_status",
      "schema": "pipeline_status.v1"
    },
    {
      "name": "eval",
      "base_url": "http://127.0.0.1:7480",
      "health_path": "/health",
      "schema": "eval_health.v1"
    }
  ],
  "repositories": [
    {
      "name": "knowin-world",
      "path_env": "KNOWIN_REPO",
      "require_clean_for_golden": true
    },
    {
      "name": "knowin-world-data",
      "path_env": "KNOWIN_DATA_ROOT",
      "require_clean_for_golden": true
    }
  ]
}
